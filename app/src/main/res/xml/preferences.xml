<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:key="config_settings_category"
        android:title="Config Settings">

        <ListPreference
            android:defaultValue="ALL"
            android:entries="@array/profile_filter_entries"
            android:entryValues="@array/profile_filter_values"
            android:key="active_profile_filter"
            android:summary="%s"
            android:title="Active Ride Profiles"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="TOP_RIGHT"
            android:entries="@array/page_switch_direction_entries"
            android:entryValues="@array/page_switch_direction_values"
            android:key="page_switch_direction"
            android:summary="%s"
            android:title="Page Switch Hardware Action"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="1"
            android:entries="@array/page_gap_entries"
            android:entryValues="@array/page_gap_values"
            android:key="page_gap_index"
            android:summary="%s"
            android:title="Page Gap Index"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="20"
            android:entries="@array/cooldown_entries"
            android:entryValues="@array/cooldown_values"
            android:key="cooldown_seconds"
            android:summary="%s"
            android:title="Flattening Return Cooldown"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="downloaded_maps_category"
        android:title="Downloaded Maps">

        <Preference
            android:key="sync_now_button"
            android:summary="Tap to scan active Karoo maps and download missing tiles over Wi-Fi"
            android:title="⚡ Sync Elevation Tiles Now" />

    </PreferenceCategory>

</PreferenceScreen>
